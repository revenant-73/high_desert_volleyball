---
import Layout from '../../layouts/Layout.astro';
import { authenticateAdmin, getAdminFromCookies, setAdminSessionCookie } from '../../lib/auth';

let error = '';

if (await getAdminFromCookies(Astro.cookies)) {
  return Astro.redirect('/admin');
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const email = data.get('email');
    const password = data.get('password');
    const session = await authenticateAdmin(email, password);

    if (session) {
      setAdminSessionCookie(Astro.cookies, session.token, session.maxAge);
      return Astro.redirect('/admin');
    } else {
      error = 'Invalid email or password';
    }
  } catch (e) {
    console.error('Admin login failed:', e);
    error = 'Unable to sign in right now';
  }
}
---

<Layout title="Admin Login | HDVL">
  <main class="min-h-screen flex items-center justify-center bg-zinc-950 px-4">
    <div class="max-w-md w-full space-y-8 bg-zinc-900 p-8 rounded-xl border border-zinc-800 shadow-2xl">
      <div>
        <h2 class="mt-6 text-center text-3xl font-extrabold text-white">
          Admin Access
        </h2>
        <p class="mt-2 text-center text-sm text-zinc-400">
          Sign in with your admin email and password
        </p>
      </div>
      <form class="mt-8 space-y-6" method="POST">
        <div class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-zinc-300 mb-2">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="username"
              required
              class="appearance-none rounded-lg relative block w-full px-3 py-3 border border-zinc-700 placeholder-zinc-500 text-white bg-zinc-800 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm"
              placeholder="admin@example.com"
            />
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-zinc-300 mb-2">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              class="appearance-none rounded-lg relative block w-full px-3 py-3 border border-zinc-700 placeholder-zinc-500 text-white bg-zinc-800 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm"
              placeholder="Password"
            />
          </div>
        </div>

        {error && (
          <div class="text-red-500 text-sm text-center bg-red-500/10 py-2 rounded-lg border border-red-500/20">
            {error}
          </div>
        )}

        <div>
          <button
            type="submit"
            class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
          >
            Sign in
          </button>
        </div>
      </form>
    </div>
  </main>
</Layout>
