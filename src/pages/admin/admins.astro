---
import Layout from '../../layouts/Layout.astro';
import {
  createOrUpdateAdminAccount,
  deleteAdminAccount,
  listAdmins,
  requireSuperAdmin,
  setAdminActive,
  updateAdminPassword,
} from '../../lib/auth';

const currentAdmin = await requireSuperAdmin(Astro.cookies);

if (!currentAdmin) {
  return Astro.redirect('/admin');
}

let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = String(data.get('action') || 'save');
    let result;

    if (action === 'reset_password') {
      result = await updateAdminPassword(data.get('admin_id'), data.get('password'));
    } else if (action === 'deactivate') {
      result = await setAdminActive(data.get('admin_id'), false, currentAdmin.id);
    } else if (action === 'activate') {
      result = await setAdminActive(data.get('admin_id'), true, currentAdmin.id);
    } else if (action === 'delete') {
      result = await deleteAdminAccount(data.get('admin_id'), currentAdmin.id);
    } else {
      result = await createOrUpdateAdminAccount({
        name: data.get('name'),
        email: data.get('email'),
        password: data.get('password'),
        role: data.get('role'),
      });
    }

    if (result.success) {
      success = action === 'save' ? 'Admin account saved.' : 'Admin account updated.';
    } else {
      error = result.error;
    }
  } catch (e) {
    console.error('Admin account save failed:', e);
    error = 'Unable to save admin account right now.';
  }
}

const admins = await listAdmins();
---

<Layout title="Manage Admins | HDVL Admin">
  <main class="min-h-screen bg-zinc-950 text-white px-4 py-8 sm:p-8">
    <div class="max-w-6xl mx-auto">
      <header class="flex flex-col gap-4 mb-8 border-b border-zinc-800 pb-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <a href="/admin" class="text-sm text-zinc-500 hover:text-white transition-colors">
            ← Dashboard
          </a>
          <h1 class="mt-3 text-3xl font-bold">Manage Admins</h1>
          <p class="text-zinc-400">Create accounts, reset passwords, and manage access.</p>
        </div>
        <form action="/api/logout" method="POST">
          <button type="submit" class="text-sm bg-zinc-800 hover:bg-zinc-700 px-4 py-2 rounded-lg transition-colors">
            Logout
          </button>
        </form>
      </header>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(360px,420px)]">
        <section class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
          <div class="px-5 py-4 border-b border-zinc-800">
            <h2 class="text-xl font-semibold">Current Admins</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="text-zinc-400 bg-zinc-950/50">
                <tr>
                  <th class="px-5 py-3 font-medium">Name</th>
                  <th class="px-5 py-3 font-medium">Email</th>
                  <th class="px-5 py-3 font-medium">Role</th>
                  <th class="px-5 py-3 font-medium">Status</th>
                  <th class="px-5 py-3 font-medium">Last Login</th>
                  <th class="px-5 py-3 font-medium text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800">
                {admins.map((admin) => (
                  <tr>
                    <td class:list={['px-5 py-4', admin.active ? 'text-zinc-200' : 'text-zinc-500']}>{admin.name || '—'}</td>
                    <td class:list={['px-5 py-4', admin.active ? 'text-zinc-200' : 'text-zinc-500']}>{admin.email}</td>
                    <td class="px-5 py-4">
                      <span class:list={[
                        'inline-flex rounded-full px-2.5 py-1 text-xs font-medium',
                        admin.role === 'super_admin'
                          ? 'bg-blue-500/15 text-blue-200 border border-blue-500/30'
                          : 'bg-zinc-800 text-zinc-300 border border-zinc-700',
                      ]}>
                        {admin.role === 'super_admin' ? 'Super Admin' : 'Admin'}
                      </span>
                    </td>
                    <td class="px-5 py-4">
                      <span class:list={[
                        'inline-flex rounded-full px-2.5 py-1 text-xs font-medium',
                        admin.active
                          ? 'bg-emerald-500/15 text-emerald-200 border border-emerald-500/30'
                          : 'bg-zinc-800 text-zinc-400 border border-zinc-700',
                      ]}>
                        {admin.active ? 'Active' : 'Inactive'}
                      </span>
                    </td>
                    <td class="px-5 py-4 text-zinc-400">{admin.last_login_at || 'Never'}</td>
                    <td class="px-5 py-4">
                      <div class="flex flex-col items-stretch gap-2">
                        <form method="POST" class="flex items-center justify-end gap-2">
                          <input type="hidden" name="action" value="reset_password" />
                          <input type="hidden" name="admin_id" value={admin.id} />
                          <label for={`password-${admin.id}`} class="sr-only">New password for {admin.email}</label>
                          <input
                            id={`password-${admin.id}`}
                            name="password"
                            type="password"
                            minlength="12"
                            required
                            placeholder="New password"
                            class="w-40 rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-white placeholder-zinc-500 focus:border-blue-500 focus:outline-none focus:ring-blue-500"
                          />
                          <button type="submit" class="rounded-lg bg-zinc-800 px-3 py-2 text-xs font-medium text-zinc-200 transition-colors hover:bg-zinc-700">
                            Reset
                          </button>
                        </form>

                        <div class="flex justify-end gap-2">
                          <form method="POST">
                            <input type="hidden" name="action" value={admin.active ? 'deactivate' : 'activate'} />
                            <input type="hidden" name="admin_id" value={admin.id} />
                            <button
                              type="submit"
                              class:list={[
                                'rounded-lg px-3 py-2 text-xs font-medium transition-colors',
                                admin.active
                                  ? 'bg-amber-500/10 text-amber-200 hover:bg-amber-500/20'
                                  : 'bg-emerald-500/10 text-emerald-200 hover:bg-emerald-500/20',
                              ]}
                            >
                              {admin.active ? 'Deactivate' : 'Activate'}
                            </button>
                          </form>
                          <form method="POST">
                            <input type="hidden" name="action" value="delete" />
                            <input type="hidden" name="admin_id" value={admin.id} />
                            <button
                              type="submit"
                              class="rounded-lg bg-red-500/10 px-3 py-2 text-xs font-medium text-red-200 transition-colors hover:bg-red-500/20"
                              onclick={`return confirm('Delete admin account ${admin.email}? This cannot be undone.')`}
                            >
                              Delete
                            </button>
                          </form>
                        </div>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="bg-zinc-900 border border-zinc-800 rounded-xl p-5">
          <h2 class="text-xl font-semibold">Add Admin</h2>
          <form class="mt-5 space-y-4" method="POST">
            <input type="hidden" name="action" value="save" />
            <div>
              <label for="name" class="block text-sm font-medium text-zinc-300 mb-2">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                class="w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-3 text-white placeholder-zinc-500 focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm"
                placeholder="Name"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-zinc-300 mb-2">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="username"
                required
                class="w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-3 text-white placeholder-zinc-500 focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm"
                placeholder="admin@example.com"
              />
            </div>

            <div>
              <label for="password" class="block text-sm font-medium text-zinc-300 mb-2">Temporary Password</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength="12"
                required
                class="w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-3 text-white placeholder-zinc-500 focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm"
                placeholder="At least 12 characters"
              />
            </div>

            <div>
              <label for="role" class="block text-sm font-medium text-zinc-300 mb-2">Role</label>
              <select
                id="role"
                name="role"
                class="w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-3 text-white focus:border-blue-500 focus:outline-none focus:ring-blue-500 sm:text-sm"
              >
                <option value="admin">Admin</option>
                <option value="super_admin">Super Admin</option>
              </select>
            </div>

            {error && (
              <div class="rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-sm text-red-300">
                {error}
              </div>
            )}

            {success && (
              <div class="rounded-lg border border-emerald-500/20 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-300">
                {success}
              </div>
            )}

            <button
              type="submit"
              class="w-full rounded-lg bg-blue-600 px-4 py-3 text-sm font-medium text-white transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-zinc-900"
            >
              Save Admin
            </button>
          </form>
        </section>
      </div>
    </div>
  </main>
</Layout>
