---
import Layout from '../../layouts/Layout.astro';
import { getAdminFromCookies } from '../../lib/auth';
import { siteConfig } from '../../lib/db';

const admin = await getAdminFromCookies(Astro.cookies);
const isSuperAdmin = admin?.role === 'super_admin';
const liveSiteUrl = 'https://www.highdesertvball.com';
---

<Layout title="Admin Dashboard | HDVL">
  <main class="min-h-screen bg-zinc-950 text-white px-4 py-6 sm:p-8">
    <div class="max-w-6xl mx-auto">
      <header class="mb-8 border-b border-zinc-800 pb-6">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex items-center gap-4">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-blue-500/30 bg-blue-500/10 p-2 shadow-lg shadow-blue-950/30">
              <img src="/hdvl_logo_transparentbg.png" alt="HDVL Logo" class="h-full w-full object-contain" />
            </div>
            <div>
              <div class="text-xs font-bold uppercase tracking-[0.2em] text-blue-400">{siteConfig.shortName} Admin</div>
              <h1 class="mt-1 text-2xl font-black tracking-tight text-white sm:text-3xl">{siteConfig.name}</h1>
              <p class="mt-1 text-sm text-zinc-400 sm:text-base">{siteConfig.tagline}</p>
            </div>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center lg:justify-end">
            <a
              href={liveSiteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-blue-500/40 bg-blue-500/10 px-4 py-2 text-sm font-semibold text-blue-100 transition-colors hover:border-blue-400 hover:bg-blue-500/20"
            >
              View Live Website
              <span aria-hidden="true">↗</span>
            </a>
            <form action="/api/logout" method="POST">
              <button type="submit" class="w-full rounded-lg bg-zinc-800 px-4 py-2 text-sm font-semibold text-zinc-200 transition-colors hover:bg-zinc-700 sm:w-auto">
                Logout
              </button>
            </form>
          </div>
        </div>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/admin/events" class="group bg-zinc-900 p-6 rounded-xl border border-zinc-800 hover:border-blue-500/50 transition-all">
          <h2 class="text-xl font-semibold mb-2 flex items-center gap-2">
            <span>Events</span>
            <span class="text-zinc-500 group-hover:translate-x-1 transition-transform">→</span>
          </h2>
          <p class="text-zinc-400">Create, update, and delete volleyball events.</p>
        </a>

        <a href="/admin/venues" class="group bg-zinc-900 p-6 rounded-xl border border-zinc-800 hover:border-blue-500/50 transition-all">
          <h2 class="text-xl font-semibold mb-2 flex items-center gap-2">
            <span>Venues</span>
            <span class="text-zinc-500 group-hover:translate-x-1 transition-transform">→</span>
          </h2>
          <p class="text-zinc-400">Manage venue locations and details.</p>
        </a>

        <a href="/admin/password" class="group bg-zinc-900 p-6 rounded-xl border border-zinc-800 hover:border-blue-500/50 transition-all">
          <h2 class="text-xl font-semibold mb-2 flex items-center gap-2">
            <span>Password</span>
            <span class="text-zinc-500 group-hover:translate-x-1 transition-transform">→</span>
          </h2>
          <p class="text-zinc-400">Change your own admin password.</p>
        </a>

        {isSuperAdmin && (
          <a href="/admin/admins" class="group bg-zinc-900 p-6 rounded-xl border border-zinc-800 hover:border-blue-500/50 transition-all">
            <h2 class="text-xl font-semibold mb-2 flex items-center gap-2">
              <span>Admins</span>
              <span class="text-zinc-500 group-hover:translate-x-1 transition-transform">→</span>
            </h2>
            <p class="text-zinc-400">Add admin accounts and manage access.</p>
          </a>
        )}
      </div>
    </div>
  </main>
</Layout>
